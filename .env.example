# Browser-facing Supabase configuration used by authentication.
# These values are intentionally public, but commit only placeholders here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration used by server-side operations/health checks.
# SUPABASE_SECRET_KEY must NEVER be prefixed NEXT_PUBLIC_ or committed with a real value.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Used only by post-deployment acceptance tests when run manually.
# In CI, the deployment URL is supplied directly by the deployment step.
ACCEPTANCE_BASE_URL=
